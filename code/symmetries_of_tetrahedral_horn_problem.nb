Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "This", " ", "finds", " ", "all", " ", "of", " ", "the", " ", "elements", 
     " ", 
     RowBox[{"of", " ", "'"}], 
     RowBox[{
      RowBox[{"matrixSignedPerms", "[", "6", "]"}], "'"}], " ", "which", " ", 
     "factor", " ", "through", " ", "the", " ", 
     RowBox[{"matrix", " ", "'"}], 
     RowBox[{"tetra", "'"}], " ", "in", " ", "the", " ", "sense", " ", 
     RowBox[{"that", " ", "\[IndentingNewLine]", "'"}], 
     RowBox[{
      RowBox[{
       RowBox[{"matrixSignedPerms", "[", "4", "]"}], "\[LeftDoubleBracket]", 
       "j", "\[RightDoubleBracket]"}], ".", "tetra"}]}], "==", 
    RowBox[{
     RowBox[{"tetra", ".", 
      RowBox[{
       RowBox[{
        RowBox[{"matrixSignedPerms", "[", "6", "]"}], "\[LeftDoubleBracket]", 
        "i", "\[RightDoubleBracket]"}], "'"}]}], " ", "holds", " ", "for", 
     " ", 
     RowBox[{"some", " ", "'"}], 
     RowBox[{"j", "'"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"TetraSignedPermutationMatrixGroup", "=", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "valid", ",", "rightSignedPerms", ",", "leftSignedPerms", ",", "i", 
         ",", "j"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"valid", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"leftSignedPerms", "=", 
         RowBox[{"matrixSignedPerms", "[", "4", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rightSignedPerms", "=", 
         RowBox[{"matrixSignedPerms", "[", "6", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "\[LessEqual]", 
           RowBox[{"Length", "[", "rightSignedPerms", "]"}]}], ",", 
          RowBox[{"i", "=", 
           RowBox[{"i", "+", "1"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", "1"}], ",", 
            RowBox[{"j", "\[LessEqual]", 
             RowBox[{"Length", "[", "leftSignedPerms", "]"}]}], ",", 
            RowBox[{"j", "=", 
             RowBox[{"j", "+", "1"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                "leftSignedPerms", "\[LeftDoubleBracket]", "j", 
                 "\[RightDoubleBracket]"}], ".", "tetra"}], "==", 
               RowBox[{"tetra", ".", 
                RowBox[{
                "rightSignedPerms", "\[LeftDoubleBracket]", "i", 
                 "\[RightDoubleBracket]"}]}]}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"AppendTo", "[", 
                RowBox[{"valid", ",", "i"}], "]"}], ";", 
               RowBox[{"Continue", "[", "]"}], ";"}]}], "\[IndentingNewLine]",
              "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
        "rightSignedPerms", "\[LeftDoubleBracket]", "valid", 
         "\[RightDoubleBracket]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
   "Length", "[", "TetraSignedPermutationMatrixGroup", "]"}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9463588401056976`*^9, 3.9463590350726233`*^9}, {
