Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "All", " ", "permutations", " ", "of", " ", "n", " ", "elements", " ", 
     "as", " ", "n", " ", "by", " ", "n", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], "-", 
    RowBox[{"valued", " ", "permutation", " ", "matrices"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"matrixPerms", "[", "n_", "]"}], ":=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Permute", "[", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "n", "]"}], ",", "#"}], "]"}], "&"}], 
      ",", 
      RowBox[{"GroupElements", "[", 
       RowBox[{"SymmetricGroup", "[", "n", "]"}], "]"}]}], "]"}]}], ";"}], 
  " "}]], "Input",
 InitializationCell->True,
