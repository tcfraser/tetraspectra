Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"EnlargeFromGenerators", "[", "gens_", "]"}], ":=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Join", "[", 
     RowBox[{"gens", ",", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Outer", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", ".", "#2"}], "&"}], ",", "gens", ",", "gens", ",", 
          "1"}], "]"}], ",", "1"}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MatrixGroupFromGenerators", "[", "gens_", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"oldgens", ",", "newgens"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"oldgens", "=", "gens"}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{"True", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"newgens", "=", 
         RowBox[{"EnlargeFromGenerators", "[", "oldgens", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "newgens", "]"}], ">", 
           RowBox[{"Length", "[", "oldgens", "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"oldgens", "=", "newgens"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Break", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
         "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "newgens"}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
