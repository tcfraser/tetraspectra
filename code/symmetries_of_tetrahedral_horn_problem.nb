Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "All", " ", "sign", " ", "flips", " ", "of", " ", "n", " ", "elements", 
     " ", "as", " ", "n", " ", "by", " ", "n", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "0", ",", "1"}], "}"}]}], "-", 
    RowBox[{"valued", "  ", "matrices"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"matrixSignFlips", "[", "n_", "]"}], ":=", 
