Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "All", " ", "signed", " ", "permutations", " ", "of", " ", "n", " ", 
     "elements", " ", "as", " ", "n", " ", "by", " ", "n", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "0", ",", "1"}], "}"}]}], "-", 
    RowBox[{"valued", " ", "signed", " ", "permutation", " ", "matrices"}]}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"matrixSignedPerms", "[", "n_", "]"}], ":=", 
    RowBox[{"ReverseSort", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#1", ".", "#2"}], "&"}], ",", 
         RowBox[{"matrixSignFlips", "[", "n", "]"}], ",", 
         RowBox[{"matrixPerms", "[", "n", "]"}], ",", "1"}], "]"}], ",", 
       "1"}], "]"}], "]"}]}], ";"}]}]], "Input",
 InitializationCell->True,
