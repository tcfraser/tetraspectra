Cell[CellGroupData[{
Cell["\<\
All \[OpenCurlyDoubleQuote]Signed\[CloseCurlyDoubleQuote] Permutations of \
(A,B,C,D,E,F) preserving the system (A+B=C, B+D=F, C+D=E, A+F=E)\
\>", "Subsection",
 CellChangeTimes->{{3.946363142815401*^9, 
  3.9463631833500233`*^9}},ExpressionUUID->"555ed45d-e851-4cc4-b299-\
f82660f75a6e"],

