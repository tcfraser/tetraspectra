     RowBox[{"DiagonalMatrix", ",", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", 
          RowBox[{"+", "1"}]}], "}"}], ",", "n"}], "]"}]}], "]"}]}], 
