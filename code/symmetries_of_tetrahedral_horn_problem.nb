Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"candidateRelations", "=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "adj", ",", "order2Edges", ",", "order4Edges", ",", 
      "fundamentalCycles"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"adj", "=", 
      RowBox[{"Normal", "[", 
       RowBox[{"AdjacencyMatrix", "[", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Apply", "[", 
            RowBox[{"UndirectedEdge", ",", "#"}], "]"}], "&"}], ",", 
          RowBox[{"EdgeList", "[", 
           RowBox[{
           "CayleyGraph", "[", "TetraSignedPermutationFormalGroup", "]"}], 
           "]"}]}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"order2Edges", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Apply", "[", "UndirectedEdge", "]"}], ",", 
        RowBox[{"Position", "[", 
         RowBox[{"adj", ",", "2"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"order4Edges", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Apply", "[", "UndirectedEdge", "]"}], ",", 
        RowBox[{"Position", "[", 
         RowBox[{"adj", ",", "1"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fundamentalCycles", "=", 
      RowBox[{"FindFundamentalCycles", "[", 
       RowBox[{"AdjacencyGraph", "[", 
        RowBox[{"adj", "/.", 
         RowBox[{"{", 
          RowBox[{"2", "->", "1"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
