Cell[TextData[StyleBox["# This is SageMath code to confirm the identity of \
the group against GAP\[CloseCurlyQuote]s standard ordering\n\nF.<a,b> = \
FreeGroup()\nR = [a^2,b^4,(a*b)^6,(b*a*b*a*b)^2]\nG = (F / \
R).as_permutation_group()\nprint(\[OpenCurlyDoubleQuote]Order of G is\
\[CloseCurlyDoubleQuote], len(G))\n\n# GAP\[CloseCurlyQuote]s AllSmallGroups \
produces list of groups of order 48\ngap_groups = \
[PermutationGroup(gap_group=K.AsPermGroup()) for K in \
gap(48).AllSmallGroups()]\nprint(\[OpenCurlyDoubleQuote]There are\
\[CloseCurlyDoubleQuote], len(gap_groups), \[OpenCurlyDoubleQuote]finite \
groups of order 48.\[CloseCurlyDoubleQuote])\n\n# Print the groups\nfor i,K \
in enumerate(gap_groups):\n    if (K.is_isomorphic(G)):\n        print(\
\[OpenCurlyDoubleQuote]G is isomorphic to GAP\[CloseCurlyQuote]s\
\[CloseCurlyDoubleQuote], i+1, \[OpenCurlyDoubleQuote]-th group of order 48\
\[CloseCurlyDoubleQuote])\n        \n\
print(\[OpenCurlyDoubleQuote]Confirmation:\[CloseCurlyDoubleQuote], \
G.is_isomorphic(PermutationGroup(gap_group=gap(48).SmallGroup(48).AsPermGroup(\
))))",
 FontColor->RGBColor[0., 0.5019607843137255, 1.]]], "Text",
 CellChangeTimes->{{3.946543108539753*^9, 3.946543154427988*^9}, {
  3.946548785397928*^9, 
  3.946548788875002*^9}},ExpressionUUID->"bc384c74-678e-9242-b72a-\
21fd4277c08c"],

