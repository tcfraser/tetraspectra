Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "a", " ", "plane", " ", "key", " ", "for", " ", "each", 
    " ", 
    RowBox[{"polygon", ":", 
     RowBox[{"normal", "+", "offset"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"planeKey", "[", 
      RowBox[{"Polygon", "[", "pts_", "]"}], "]"}], ":=", 
     RowBox[{"Normalize", "[", 
      RowBox[{"Cross", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"pts", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "-", 
         RowBox[{"pts", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"pts", "[", 
          RowBox[{"[", "3", "]"}], "]"}], "-", 
         RowBox[{"pts", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "get", " ", "all", " ", "edges", " ", "from", 
     " ", "a", " ", "polygon"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"polyEdges", "[", 
      RowBox[{"Polygon", "[", "pts_", "]"}], "]"}], ":=", 
     RowBox[{"Map", "[", 
      RowBox[{"Sort", ",", 
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"Append", "[", 
          RowBox[{"pts", ",", 
           RowBox[{"First", "[", "pts", "]"}]}], "]"}], ",", "2", ",", "1"}], 
        "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Function", " ", "to", " ", "get", " ", "all", " ", "edges", " ", "from",
       " ", "a", " ", "polygon"}], ",", " ", 
     RowBox[{
     "marked", " ", "by", " ", "normal", " ", "of", " ", "that", " ", 
      "polygon"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polyNormalEdges", "[", 
     RowBox[{"Polygon", "[", "pts_", "]"}], "]"}], ":=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"planeKey", "[", 
          RowBox[{"Polygon", "[", "pts", "]"}], "]"}], ",", "#"}], "}"}], 
       "&"}], ",", 
      RowBox[{"polyEdges", "[", 
       RowBox[{"Polygon", "[", "pts", "]"}], "]"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PlotTriangleIneqs", "[", 
     RowBox[{"va_", ",", "vb_", ",", "vc_"}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ineqs", ",", "candidateVertices", ",", "actualVertices", ",", "hull", 
        ",", "polys", ",", "\[IndentingNewLine]", "normalMarkedEdges", ",", 
        "uniqueEdgesAndNormals", ",", "uniqueEdgesCameraKey", ",", 
        "cameraPosition", ",", "edgesAndCameraFacing", ",", 
        "\[IndentingNewLine]", "edgesFacingCamera", ",", "edgesAwayCamera", 
        ",", "interiorShade", ",", "wireframe", ",", "frame"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ineqs", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "\[GreaterEqual]", "0"}], "&"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"b", "+", "x", "-", "a"}], ",", 
             RowBox[{"a", "+", "b", "-", "x"}], ",", 
             RowBox[{"a", "+", "x", "-", "b"}], ",", 
             RowBox[{"c", "+", "y", "-", "b"}], ",", 
             RowBox[{"b", "+", "c", "-", "y"}], ",", 
             RowBox[{"b", "+", "y", "-", "c"}], ",", 
             RowBox[{"x", "+", "z", "-", "c"}], ",", 
             RowBox[{"c", "+", "x", "-", "z"}], ",", 
             RowBox[{"c", "+", "z", "-", "x"}], ",", 
             RowBox[{"a", "+", "z", "-", "y"}], ",", 
             RowBox[{"a", "+", "y", "-", "z"}], ",", 
             RowBox[{"y", "+", "z", "-", "a"}]}], "}"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "\[Rule]", "va"}], ",", 
             RowBox[{"b", "\[Rule]", "vb"}], ",", 
             RowBox[{"c", "\[Rule]", "vc"}]}], "}"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"candidateVertices", "=", "\[IndentingNewLine]", 
        RowBox[{"Select", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Solve", "[", 
              RowBox[{"#", ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", "Reals"}], 
              "]"}], "&"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{"Apply", "[", "And", "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Subsets", "[", 
               RowBox[{
                RowBox[{"ineqs", "/.", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"GreaterEqual", "\[Rule]", "Equal"}], ",", 
                   RowBox[{"LessEqual", "\[Rule]", "Equal"}]}], "}"}]}], ",", 
                RowBox[{"{", "3", "}"}]}], "\[IndentingNewLine]", "]"}]}], 
             "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"actualVertices", "=", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"First", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", ",", "y", ",", "z"}], "}"}], "/.", "#"}], "]"}], 
            "&"}], ",", 
           RowBox[{"Select", "[", 
            RowBox[{"candidateVertices", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Apply", "[", 
                RowBox[{"And", ",", "ineqs"}], "]"}], "/.", 
               RowBox[{"First", "[", "#", "]"}]}], "&"}]}], "]"}]}], "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"hull", "=", 
        RowBox[{"ConvexHullMesh", "[", "actualVertices", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"polys", "=", 
        RowBox[{"MeshPrimitives", "[", 
         RowBox[{"hull", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "normals", " ", "and", " ", "edges", " ", "grouped", " ", 
         "together"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"normalMarkedEdges", " ", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{"polyNormalEdges", ",", "polys"}], "]"}], ",", "1"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"uniqueEdgesAndNormals", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"First", "[", 
              RowBox[{"Rest", "[", 
               RowBox[{"First", "[", "#", "]"}], "]"}], "]"}], ",", 
             RowBox[{"First", "[", 
              RowBox[{"Transpose", "[", "#", "]"}], "]"}]}], "}"}], "&"}], 
          ",", 
          RowBox[{"GatherBy", "[", 
           RowBox[{"normalMarkedEdges", ",", "Rest"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"cameraPosition", "=", 
        RowBox[{"{", 
         RowBox[{"100", ",", 
          RowBox[{"-", "100"}], ",", "0"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"uniqueEdgesCameraKey", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"First", "[", "#", "]"}], ",", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"Map", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"cameraPosition", ".", "##"}], "&"}], ",", 
                 RowBox[{"First", "[", 
                  RowBox[{"Rest", "[", "#", "]"}], "]"}]}], "]"}], "]"}], ">=",
               "0"}]}], "}"}], "&"}], ",", "uniqueEdgesAndNormals"}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"edgesFacingCamera", "=", 
        RowBox[{"Map", "[", 
         RowBox[{"First", ",", 
          RowBox[{"Select", "[", 
           RowBox[{"uniqueEdgesCameraKey", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"First", "[", 
               RowBox[{"Rest", "[", "#", "]"}], "]"}], "==", "True"}], 
             "&"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"edgesAwayCamera", "    ", "=", 
        RowBox[{"Map", "[", 
         RowBox[{"First", ",", 
          RowBox[{"Select", "[", 
           RowBox[{"uniqueEdgesCameraKey", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"First", "[", 
               RowBox[{"Rest", "[", "#", "]"}], "]"}], "==", "False"}], 
             "&"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"wireframe", "=", 
        RowBox[{"Show", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics3D", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Darker", "[", "Blue", "]"}], ",", "                 ", 
             RowBox[{"AbsoluteThickness", "[", "1", "]"}], ",", 
             RowBox[{"Line", "/@", "edgesFacingCamera"}]}], "}"}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"Graphics3D", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Darker", "[", "Blue", "]"}], ",", "Dotted", ",", 
             RowBox[{"AbsoluteThickness", "[", "1", "]"}], ",", 
             RowBox[{"Line", "/@", "edgesAwayCamera"}]}], "}"}], "]"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"interiorShade", "=", 
        RowBox[{"RegionPlot3D", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Apply", "[", 
           RowBox[{"And", ",", "ineqs"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"Abs", "[", 
             RowBox[{"va", "-", "vb"}], "]"}], ",", 
            RowBox[{"va", "+", "vb"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
            RowBox[{"Abs", "[", 
             RowBox[{"vc", "-", "vb"}], "]"}], ",", 
            RowBox[{"vc", "+", "vb"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"z", ",", "0", ",", 
            RowBox[{"va", "+", "vb", "+", "vc"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PlotPoints", "\[Rule]", "100"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PlotStyle", "\[Rule]", 
           RowBox[{"Directive", "[", 
            RowBox[{"Blue", ",", 
             RowBox[{"Opacity", "[", "0.05", "]"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Mesh", "\[Rule]", "None"}], ",", "\[IndentingNewLine]", 
          RowBox[{"BoundaryStyle", "->", "None"}], ",", "\[IndentingNewLine]", 
          RowBox[{"AxesLabel", "\[Rule]", "Automatic"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"frame", "=", 
        RowBox[{"RegionPlot3D", "[", 
         RowBox[{"False", ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"Abs", "[", 
             RowBox[{"va", "-", "vb"}], "]"}], ",", 
            RowBox[{"va", "+", "vb"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
            RowBox[{"Abs", "[", 
             RowBox[{"vc", "-", "vb"}], "]"}], ",", 
            RowBox[{"vc", "+", "vb"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"z", ",", "0", ",", 
            RowBox[{"va", "+", "vb", "+", "vc"}]}], "}"}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"PlotPoints", "\[Rule]", "2"}], ",", "\[IndentingNewLine]", 
          RowBox[{"AxesLabel", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"MaTeX", "[", "\"\<\\\\ell_c\>\"", "]"}], ",", 
             RowBox[{"MaTeX", "[", "\"\<\\\\ell_f\>\"", "]"}], ",", 
             RowBox[{"MaTeX", "[", "\"\<\\\\ell_e\>\"", "]"}]}], "}"}]}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"AxesEdge", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", 
               RowBox[{"-", "1"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"+", "1"}], ",", 
               RowBox[{"-", "1"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"+", "1"}], ",", 
               RowBox[{"+", "1"}]}], "}"}]}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Boxed", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"Back", ",", "Bottom", ",", "Left"}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"BoxStyle", "->", 
           RowBox[{"Opacity", "[", "0.2", "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"AxesStyle", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"Black", ",", "Bold"}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PlotStyle", "\[Rule]", 
           RowBox[{"{", "Thick", "}"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"ViewPoint", "->", 
           RowBox[{"{", 
            RowBox[{"9", ",", 
             RowBox[{"-", "10"}], ",", 
             RowBox[{"+", "2"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"PlotLabel", "\[Rule]", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{
             "MaTeX", "[", 
              "\"\<\\\\ell_a = 5, \\,\\, \\\\ell_b = 7, \\,\\, \\\\ell_d = \
6\>\"", "]"}], ",", "Medium"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Show", "[", 
        RowBox[{"frame", ",", "interiorShade", ",", "wireframe"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}]}]}]], "Input",
