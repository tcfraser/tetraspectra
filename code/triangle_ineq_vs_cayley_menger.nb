Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "a", " ", "plane", " ", "key", " ", "for", " ", "each", 
    " ", 
    RowBox[{"polygon", ":", 
     RowBox[{"normal", "+", "offset"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"planeKey", "[", 
      RowBox[{"Polygon", "[", "pts_", "]"}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", "d"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Normalize", "[", 
          RowBox[{"Cross", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"pts", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", 
             RowBox[{"pts", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"pts", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "-", 
             RowBox[{"pts", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"d", "=", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{"n", ".", 
            RowBox[{"pts", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Round", "[", 
           RowBox[{"n", ",", 
            RowBox[{"10", "^", 
             RowBox[{"-", "8"}]}]}], "]"}], ",", "d"}], "}"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "get", " ", "all", " ", "edges", " ", "from", 
     " ", "a", " ", "polygon"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"polyEdges", "[", 
      RowBox[{"Polygon", "[", "pts_", "]"}], "]"}], ":=", 
     RowBox[{"Partition", "[", 
      RowBox[{
       RowBox[{"Append", "[", 
        RowBox[{"pts", ",", 
         RowBox[{"First", "[", "pts", "]"}]}], "]"}], ",", "2", ",", "1"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PlotTriangleIneqs", "[", 
     RowBox[{"va_", ",", "vb_", ",", "vc_"}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ineqs", ",", "candidateVertices", ",", "actualVertices", ",", "hull", 
        ",", "polys", ",", "groups", ",", "boundaryEdges", ",", 
        "interiorShade", ",", "wireframe", ",", "frame"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ineqs", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "\[GreaterEqual]", "0"}], "&"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"b", "+", "x", "-", "a"}], ",", 
             RowBox[{"a", "+", "b", "-", "x"}], ",", 
             RowBox[{"a", "+", "x", "-", "b"}], ",", 
             RowBox[{"c", "+", "y", "-", "b"}], ",", 
             RowBox[{"b", "+", "c", "-", "y"}], ",", 
             RowBox[{"b", "+", "y", "-", "c"}], ",", 
             RowBox[{"x", "+", "z", "-", "c"}], ",", 
             RowBox[{"c", "+", "x", "-", "z"}], ",", 
             RowBox[{"c", "+", "z", "-", "x"}], ",", 
             RowBox[{"a", "+", "z", "-", "y"}], ",", 
             RowBox[{"a", "+", "y", "-", "z"}], ",", 
             RowBox[{"y", "+", "z", "-", "a"}]}], "}"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "\[Rule]", "va"}], ",", 
             RowBox[{"b", "\[Rule]", "vb"}], ",", 
             RowBox[{"c", "\[Rule]", "vc"}]}], "}"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"candidateVertices", "=", "\[IndentingNewLine]", 
        RowBox[{"Select", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Solve", "[", 
              RowBox[{"#", ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", "Reals"}], 
              "]"}], "&"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{"Apply", "[", "And", "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Subsets", "[", 
               RowBox[{
                RowBox[{"ineqs", "/.", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"GreaterEqual", "\[Rule]", "Equal"}], ",", 
                   RowBox[{"LessEqual", "\[Rule]", "Equal"}]}], "}"}]}], ",", 
                RowBox[{"{", "3", "}"}]}], "\[IndentingNewLine]", "]"}]}], 
             "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"actualVertices", "=", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"First", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", ",", "y", ",", "z"}], "}"}], "/.", "#"}], "]"}], 
            "&"}], ",", 
           RowBox[{"Select", "[", 
            RowBox[{"candidateVertices", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Apply", "[", 
                RowBox[{"And", ",", "ineqs"}], "]"}], "/.", 
               RowBox[{"First", "[", "#", "]"}]}], "&"}]}], "]"}]}], "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"hull", "=", 
        RowBox[{"ConvexHullMesh", "[", "actualVertices", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"polys", "=", 
        RowBox[{"MeshPrimitives", "[", 
         RowBox[{"hull", ",", "2"}], "]"}]}], ";", "\n", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Group", " ", "polygons", " ", "by", " ", "coplanar", " ", "plane"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"groups", "=", 
        RowBox[{"GatherBy", "[", 
         RowBox[{"polys", ",", "planeKey"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"For", " ", "each", " ", "coplanar", " ", "group"}], ",", 
         RowBox[{
         "find", " ", "edges", " ", "shared", " ", "by", " ", "multiple", " ",
           "polygons"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"boundaryEdges", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"edges", "=", 
              RowBox[{"polyEdges", "/@", "grp"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"edgesFlat", "=", 
              RowBox[{"Flatten", "[", 
               RowBox[{"edges", ",", "1"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"counts", "=", 
              RowBox[{"Counts", "[", 
               RowBox[{"Sort", "/@", "edgesFlat"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Select", "[", 
              RowBox[{"edgesFlat", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"counts", "[", 
                  RowBox[{"Sort", "[", "#", "]"}], "]"}], "\[Equal]", "1"}], 
                "&"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"grp", ",", "groups"}], "}"}]}], "]"}], ",", "1"}], 
         "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
        "keep", " ", "edges", " ", "used", " ", "only", " ", "once", " ", 
         "in", " ", "this", " ", "group"}], "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"wireframe", "=", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{"{", 
          RowBox[{"Black", ",", 
           RowBox[{"AbsoluteThickness", "[", "1", "]"}], ",", 
           RowBox[{"Line", "/@", "boundaryEdges"}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"interiorShade", "=", 
        RowBox[{"RegionPlot3D", "[", 
         RowBox[{
          RowBox[{"Apply", "[", 
           RowBox[{"And", ",", "ineqs"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"Abs", "[", 
             RowBox[{"va", "-", "vb"}], "]"}], ",", 
            RowBox[{"va", "+", "vb"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
            RowBox[{"Abs", "[", 
             RowBox[{"vc", "-", "vb"}], "]"}], ",", 
            RowBox[{"vc", "+", "vb"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"z", ",", "0", ",", 
            RowBox[{"va", "+", "vb", "+", "vc"}]}], "}"}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"PlotPoints", "\[Rule]", "50"}], ",", 
          RowBox[{"PlotStyle", "\[Rule]", 
           RowBox[{"Directive", "[", 
            RowBox[{"Blue", ",", 
             RowBox[{"Opacity", "[", "0.05", "]"}]}], "]"}]}], ",", 
          RowBox[{"Mesh", "\[Rule]", "None"}], ",", 
          RowBox[{"AxesLabel", "\[Rule]", "Automatic"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"frame", "=", 
        RowBox[{"RegionPlot3D", "[", 
         RowBox[{"False", ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"Abs", "[", 
             RowBox[{"va", "-", "vb"}], "]"}], ",", 
            RowBox[{"va", "+", "vb"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
            RowBox[{"Abs", "[", 
             RowBox[{"vc", "-", "vb"}], "]"}], ",", 
            RowBox[{"vc", "+", "vb"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"z", ",", "0", ",", 
            RowBox[{"va", "+", "vb", "+", "vc"}]}], "}"}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"PlotPoints", "\[Rule]", "2"}], ",", "\[IndentingNewLine]", 
          RowBox[{"AxesLabel", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
              "\"\<\!\(\*SubscriptBox[\(\[ScriptL]\), \(c\)]\)\>\"", ",", 
               "Medium", ",", "Bold", ",", "Black"}], "]"}], ",", 
             RowBox[{"Style", "[", 
              RowBox[{
              "\"\<\!\(\*SubscriptBox[\(\[ScriptL]\), \(f\)]\)\>\"", ",", 
               "Medium", ",", "Bold", ",", "Black"}], "]"}], ",", 
             RowBox[{"Style", "[", 
              RowBox[{
              "\"\<\!\(\*SubscriptBox[\(\[ScriptL]\), \(e\)]\)\>\"", ",", 
               "Medium", ",", "Bold", ",", "Black"}], "]"}]}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"AxesEdge", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
