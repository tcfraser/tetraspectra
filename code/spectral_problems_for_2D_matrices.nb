Cell[BoxData[{
 RowBox[{
  RowBox[{"tripleAngleConstraint", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Cos\[Theta]ab", ",", "Cos\[Theta]bc", ",", "Cos\[Theta]ac"}], 
      "}"}], ",", 
     RowBox[{"1", "\[GreaterEqual]", 
      RowBox[{"Det", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "Cos\[Theta]ab", ",", "Cos\[Theta]ac"}], "}"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"Cos\[Theta]ab", ",", "1", ",", "Cos\[Theta]bc"}], "}"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"Cos\[Theta]ac", ",", "Cos\[Theta]bc", ",", "1"}], "}"}]}], 
        "}"}], "]"}], "\[GreaterEqual]", "0"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Inequalities", " ", "on", " ", "angles", " ", "from", " ", "Gram", " ", 
    "matrix", " ", "positivity", "\[IndentingNewLine]", 
    RowBox[{"Minimize", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"cos\[Theta]ac", ",", 
        RowBox[{"tripleAngleConstraint", "[", 
         RowBox[{
         "cos\[Theta]ab", ",", "cos\[Theta]bc", ",", "cos\[Theta]ac"}], 
         "]"}]}], "}"}], ",", "cos\[Theta]ac"}], "]"}], "\[IndentingNewLine]", 
    RowBox[{"Maximize", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"cos\[Theta]ac", ",", 
        RowBox[{"tripleAngleConstraint", "[", 
         RowBox[{
         "cos\[Theta]ab", ",", "cos\[Theta]bc", ",", "cos\[Theta]ac"}], 
         "]"}]}], "}"}], ",", "cos\[Theta]ac"}], "]"}]}], 
   "\[IndentingNewLine]", "*)"}]}]}], "Input",
 CellChangeTimes->{{3.925814150598248*^9, 3.925814154035354*^9}, {
  3.925821137123603*^9, 3.925821152445035*^9}},
 CellLabel->
  "In[243]:=",ExpressionUUID->"3117ce3d-989c-4de2-8b6f-16ff9d39b3e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TracelessSpectraToAdmissibleHyperbolicRegion", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Function", "[", 
   RowBox[{
    RowBox[{"{", "s", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "xmin", ",", "xmax", ",", "ymin", ",", "ymax", ",", "halfFterm", ",", 
        "Fdiffterm", ",", "cos\[Theta]ab", ",", "cos\[Theta]bc", ",", 
        "mincos\[Theta]ac", ",", "maxcos\[Theta]ac"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"cos\[Theta]ab", "=", 
        FractionBox[
         RowBox[{
          RowBox[{"Cosh", "[", 
           RowBox[{"2", "s", "*", "x"}], "]"}], "-", 
          RowBox[{
           RowBox[{"Cosh", "[", 
            RowBox[{"2", "s", "*", "a"}], "]"}], 
           RowBox[{"Cosh", "[", 
            RowBox[{"2", "s", "*", "b"}], "]"}]}]}], 
         RowBox[{
          RowBox[{"Sinh", "[", 
           RowBox[{"2", "s", "*", "a"}], "]"}], 
          RowBox[{"Sinh", "[", 
           RowBox[{"2", "s", "*", "b"}], "]"}]}]]}], ";", 
       RowBox[{"cos\[Theta]bc", "=", 
        FractionBox[
         RowBox[{
          RowBox[{"Cosh", "[", 
           RowBox[{"2", "s", "*", "y"}], "]"}], "-", 
          RowBox[{
           RowBox[{"Cosh", "[", 
            RowBox[{"2", "s", "*", "b"}], "]"}], 
           RowBox[{"Cosh", "[", 
            RowBox[{"2", "s", "*", "c"}], "]"}]}]}], 
         RowBox[{
          RowBox[{"Sinh", "[", 
           RowBox[{"2", "s", "*", "b"}], "]"}], 
          RowBox[{"Sinh", "[", 
           RowBox[{"2", "s", "*", "c"}], "]"}]}]]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"halfFterm", "=", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Cosh", "[", 
           RowBox[{"2", " ", "a", " ", "s"}], "]"}], " ", 
          RowBox[{"Cosh", "[", 
           RowBox[{"2", " ", "b", " ", "s"}], "]"}], " ", 
          RowBox[{"Cosh", "[", 
           RowBox[{"2", " ", "c", " ", "s"}], "]"}]}], "+", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Cosh", "[", 
           RowBox[{"2", "s", "*", "c"}], "]"}], 
          RowBox[{"Sinh", "[", 
           RowBox[{"2", "s", "*", "b"}], "]"}], 
          RowBox[{"Sinh", "[", 
           RowBox[{"2", "s", "*", "a"}], "]"}], "cos\[Theta]ab"}], "+", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Sinh", "[", 
           RowBox[{"2", "s", "*", "c"}], "]"}], 
          RowBox[{"Sinh", "[", 
           RowBox[{"2", "s", "*", "b"}], "]"}], 
          RowBox[{"Cosh", "[", 
           RowBox[{"2", "s", "*", "a"}], "]"}], "cos\[Theta]bc"}], "+", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Sinh", "[", 
           RowBox[{"2", "s", "*", "c"}], "]"}], 
          RowBox[{"Cosh", "[", 
           RowBox[{"2", "s", "*", "b"}], "]"}], 
          RowBox[{"Sinh", "[", 
           RowBox[{"2", "s", "*", "a"}], "]"}], "cos\[Theta]ab", " ", 
          "cos\[Theta]bc"}], "+", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sinh", "[", 
            RowBox[{"2", "s", "*", "c"}], "]"}]}], 
          RowBox[{"Sinh", "[", 
           RowBox[{"2", "s", "*", "a"}], "]"}], "cos\[Theta]ab", " ", 
          "cos\[Theta]bc"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Fdiffterm", "=", 
        RowBox[{
         RowBox[{"Sinh", "[", 
          RowBox[{"2", "s", "*", "a"}], "]"}], 
         RowBox[{"Sinh", "[", 
          RowBox[{"2", "s", "*", "c"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"maxcos\[Theta]ac", "=", 
        RowBox[{
         RowBox[{"cos\[Theta]ab", " ", "cos\[Theta]bc"}], "+", 
         SqrtBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             SuperscriptBox["cos\[Theta]ab", "2"]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             SuperscriptBox["cos\[Theta]bc", "2"]}], ")"}]}]]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mincos\[Theta]ac", "=", 
        RowBox[{
         RowBox[{"cos\[Theta]ab", " ", "cos\[Theta]bc"}], "-", 
         SqrtBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             SuperscriptBox["cos\[Theta]ab", "2"]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             SuperscriptBox["cos\[Theta]bc", "2"]}], ")"}]}]]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xmin", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"b", "-", "a"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xmax", "=", 
        RowBox[{"a", "+", "b"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ymin", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"c", "-", "b"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ymax", "=", 
        RowBox[{"b", "+", "c"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Show", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Plot3D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ArcCosh", "[", 
             RowBox[{"halfFterm", "+", 
              RowBox[{"maxcos\[Theta]ac", "*", "Fdiffterm"}]}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", "*", "s"}], ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", "ymin", ",", "ymax"}], "}"}], ",", 
           RowBox[{"PlotStyle", "->", "boundaryColor"}], ",", 
           RowBox[{"MeshStyle", "\[Rule]", 
            RowBox[{"Opacity", "[", "0.1", "]"}]}], ",", 
           RowBox[{"Axes", "->", "False"}], ",", 
           RowBox[{"Boxed", "->", "False"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Plot3D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ArcCosh", "[", 
             RowBox[{"halfFterm", "+", 
              RowBox[{"mincos\[Theta]ac", "*", "Fdiffterm"}]}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", "*", "s"}], ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", "ymin", ",", "ymax"}], "}"}], ",", 
           RowBox[{"PlotStyle", "->", "boundaryColor"}], ",", 
           RowBox[{"MeshStyle", "\[Rule]", 
            RowBox[{"Opacity", "[", "0.1", "]"}]}], ",", 
