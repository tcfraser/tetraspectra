Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPointPlot3D", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rand\[Phi]", ",", "randz"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rand\[Phi]", "=", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"2", "*", "Pi"}]}], "}"}], ",", "PoolSize"}], "]"}]}], ";", 
      RowBox[{"randz", "=", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"sDeformedDist", "[", 
          RowBox[{"4", ",", "1"}], "]"}], ",", "PoolSize", ",", 
         RowBox[{"Method", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<MCMC\>\"", ",", 
            RowBox[{"\"\<Thinning\>\"", "\[Rule]", "20"}], ",", 
            RowBox[{"\"\<InitialVariance\>\"", "\[Rule]", "0.01"}], ",", 
            RowBox[{"\"\<InitialPoint\>\"", "\[Rule]", "0.01"}], ",", 
            RowBox[{"\"\<BurnInPeriod\>\"", "\[Rule]", "1000"}]}], "}"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", "-", 
              SuperscriptBox[
               RowBox[{
               "randz", "\[LeftDoubleBracket]", "#", 
                "\[RightDoubleBracket]"}], "2"]}], "]"}], "*", 
            RowBox[{"Cos", "[", 
             RowBox[{
             "rand\[Phi]", "\[LeftDoubleBracket]", "#", 
              "\[RightDoubleBracket]"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", "-", 
              SuperscriptBox[
               RowBox[{
               "randz", "\[LeftDoubleBracket]", "#", 
                "\[RightDoubleBracket]"}], "2"]}], "]"}], "*", 
            RowBox[{"Sin", "[", 
             RowBox[{
             "rand\[Phi]", "\[LeftDoubleBracket]", "#", 
              "\[RightDoubleBracket]"}], "]"}]}], ",", 
           RowBox[{
           "randz", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}]}], 
          "}"}], "&"}], ",", 
        RowBox[{"Range", "[", "PoolSize", "]"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}], ",", 
   RowBox[{"BoxRatios", "\[Rule]", 
    RowBox[{"{", 
