      RowBox[{"a", "+", "b"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"c", "-", "b"}], "]"}], ",", 
      RowBox[{"b", "+", "c"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
