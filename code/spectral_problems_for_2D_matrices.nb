Cell[CellGroupData[{

Cell["Sampling admissible AB,BC,ABC regions", "Subsection",
 CellChangeTimes->{{3.9234717239792557`*^9, 3.9234717818381653`*^9}, {
  3.923545972641297*^9, 
  3.9235459775474386`*^9}},ExpressionUUID->"59ecacaf-0660-dd4a-95ad-\
1511aa87ddfb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"AdmissibleLeadingSingularValues", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "numSamples", ",", "\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]"}], "}"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "UA", ",", "UB", ",", "UC", ",", "HA", ",", "HB", ",", "HC", ",", 
         "EA", ",", "EB", ",", "EC", ",", "EAB", ",", "EBC", ",", "EABC", ",",
          "NormalLSAB", ",", "NormalLSBC", ",", "NormalLSABC", ",", 
         "ExpFunction"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ExpFunction", "=", "MatrixExp"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "independent", " ", "haar", " ", "unitary", " ", "samples"}], " ", 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"UA", "=", 
           RowBox[{"HaarUnitaryPool", "\[LeftDoubleBracket]", 
            RowBox[{"1", ";;", "numSamples"}], "\[RightDoubleBracket]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"UB", "=", 
           RowBox[{"HaarUnitaryPool", "\[LeftDoubleBracket]", 
            RowBox[{
             RowBox[{"numSamples", "+", "1"}], ";;", 
             RowBox[{"2", "*", "numSamples"}]}], "\[RightDoubleBracket]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"UC", "=", 
           RowBox[{"HaarUnitaryPool", "\[LeftDoubleBracket]", 
            RowBox[{
             RowBox[{
              RowBox[{"2", "*", "numSamples"}], "+", "1"}], ";;", 
             RowBox[{"3", "*", "numSamples"}]}], "\[RightDoubleBracket]"}]}], 
          ";"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "random", " ", "coadjoint", " ", "orbits", " ", "with", " ", 
           "fixed", " ", "spectra"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"HA", "=", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"CoadjointOrbit", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "\[Alpha]"}], ",", "\[Alpha]"}], "}"}], ",", 
                "#"}], "]"}], "&"}], ",", "UA"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"HB", "=", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"CoadjointOrbit", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "\[Beta]"}], ",", "\[Beta]"}], "}"}], ",", 
                "#"}], "]"}], "&"}], ",", "UB"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"HC", "=", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"CoadjointOrbit", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "\[Gamma]"}], ",", "\[Gamma]"}], "}"}], ",", 
                "#"}], "]"}], "&"}], ",", "UC"}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", "s", "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "independent", " ", "s", " ", "deformed", " ", "random", " ", 
            "orbit", " ", 
            RowBox[{"samples", " ", "**"}], "*", " ", 
            RowBox[{"traceless", " ", "**"}], "*"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"EA", "=", 
            RowBox[{
             RowBox[{"sDeformedRandomOrbitElementPool", "[", 
              RowBox[{"s", ",", "\[Alpha]"}], "]"}], "\[LeftDoubleBracket]", 
             RowBox[{"1", ";;", "numSamples"}], "\[RightDoubleBracket]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"EB", "=", 
            RowBox[{
             RowBox[{"sDeformedRandomOrbitElementPool", "[", 
              RowBox[{"s", ",", "\[Beta]"}], "]"}], "\[LeftDoubleBracket]", 
             RowBox[{"1", ";;", "numSamples"}], "\[RightDoubleBracket]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"EC", "=", 
            RowBox[{
             RowBox[{"sDeformedRandomOrbitElementPool", "[", 
              RowBox[{"s", ",", "\[Gamma]"}], "]"}], "\[LeftDoubleBracket]", 
             RowBox[{"1", ";;", "numSamples"}], "\[RightDoubleBracket]"}]}], 
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "random", " ", "elements", " ", "from", " ", "orbits", " ", 
             "with", " ", "fixed", " ", "singular", " ", "values", " ", 
             RowBox[{"(", 
              RowBox[{"scaled", " ", "by", " ", "s"}], ")"}]}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"(*", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"EA", "=", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ExpFunction", "[", 
                  RowBox[{"s", "*", 
                   RowBox[{
                   "HA", "\[LeftDoubleBracket]", "#", 
                    "\[RightDoubleBracket]"}]}], "]"}], "&"}], ",", 
                RowBox[{"Range", "[", "numSamples", "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"EB", "=", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ExpFunction", "[", 
                  RowBox[{"s", "*", 
                   RowBox[{
                   "HB", "\[LeftDoubleBracket]", "#", 
                    "\[RightDoubleBracket]"}]}], "]"}], "&"}], ",", 
                RowBox[{"Range", "[", "numSamples", "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"EC", "=", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ExpFunction", "[", 
                  RowBox[{"s", "*", 
                   RowBox[{
                   "HC", "\[LeftDoubleBracket]", "#", 
                    "\[RightDoubleBracket]"}]}], "]"}], "&"}], ",", 
                RowBox[{"Range", "[", "numSamples", "]"}]}], "]"}]}], ";"}], 
            "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "products", " ", "of", " ", "random", " ", "dressed", " ", 
             "orbits"}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"EAB", "=", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                "EA", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
                ".", 
                RowBox[{
                "EB", "\[LeftDoubleBracket]", "#", 
                 "\[RightDoubleBracket]"}]}], "&"}], ",", 
              RowBox[{"Range", "[", "numSamples", "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"EBC", "=", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                "EB", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
                ".", 
                RowBox[{
                "EC", "\[LeftDoubleBracket]", "#", 
                 "\[RightDoubleBracket]"}]}], "&"}], ",", 
              RowBox[{"Range", "[", "numSamples", "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"EABC", "=", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                "EA", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
                ".", 
                RowBox[{
                "EB", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
                ".", 
                RowBox[{
                "EC", "\[LeftDoubleBracket]", "#", 
                 "\[RightDoubleBracket]"}]}], "&"}], ",", 
              RowBox[{"Range", "[", "numSamples", "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "normalized", " ", "leading", " ", "singular", " ", "values", " ",
              "of", " ", "these", " ", "products"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"NormalLSAB", "=", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                SuperscriptBox["s", 
                 RowBox[{"-", "1"}]], "*", 
                RowBox[{"Log", "[", 
                 RowBox[{"LeadingSingularvalue", "[", "#", "]"}], "]"}]}], 
               "&"}], ",", "EAB"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"NormalLSBC", "=", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                SuperscriptBox["s", 
                 RowBox[{"-", "1"}]], "*", 
                RowBox[{"Log", "[", 
                 RowBox[{"LeadingSingularvalue", "[", "#", "]"}], "]"}]}], 
               "&"}], ",", "EBC"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"NormalLSABC", "=", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                SuperscriptBox["s", 
                 RowBox[{"-", "1"}]], "*", 
                RowBox[{"Log", "[", 
                 RowBox[{"LeadingSingularvalue", "[", "#", "]"}], "]"}]}], 
               "&"}], ",", "EABC"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Plotting", " ", "leading", " ", "singular", " ", "values"}], " ",
             "*)"}], "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"s", ",", 
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"NormalLSAB", ",", "NormalLSBC", ",", "NormalLSABC"}], 
               "}"}], "]"}]}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ALSVOutputToPlot", "[", 
   RowBox[{"data_", ",", "options_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "sString", "}"}], ",", 
    RowBox[{
     RowBox[{"sString", "=", 
      RowBox[{"ToString", "[", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"N", "[", 
