Cell[BoxData[{
 RowBox[{
  RowBox[{"plotRange", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"b", "-", "a"}], "]"}], ",", 
      RowBox[{"a", "+", "b"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"c", "-", "b"}], "]"}], ",", 
      RowBox[{"b", "+", "c"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"a", "+", "b", "+", "c"}]}], "}"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"smallSViewPoint", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"0.0", "*", "Pi"}], ",", 
     RowBox[{
      RowBox[{"-", "0.5"}], "*", "Pi"}], ",", "0.0"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"largeSViewPoint", "=", 
   RowBox[{"{", 
