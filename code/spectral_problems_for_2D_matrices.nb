3d2632fd02a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"h", "[", "x_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "\[Equal]", "0"}], "||", 
     RowBox[{"x", "\[Equal]", "1"}]}], ",", "0", ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "1"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "x"}], " ", 
        RowBox[{"Log", "[", "x", "]"}]}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "x"}], ")"}], 
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", "x"}], "]"}]}]}], ",", 
      RowBox[{"Assert", "[", "False", "]"}]}], "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.925889822810979*^9, 3.92588984468871*^9}, {
   3.925891988747707*^9, 3.925892004476946*^9}, {3.925892123543312*^9, 
