  RowBox[{"Max", "[", 
   RowBox[{
    RowBox[{"a", "+", "c", "+", "x", "+", "y"}], ",", 
    RowBox[{"a", "+", "b", "+", "c", "+", "z"}], ",", 
    RowBox[{"b", "+", "x", "+", "y", "+", "z"}]}], "]"}], "\[GreaterEqual]", 
  RowBox[{"Max", "[", 
