Cell[BoxData[
 Graphics3DBox[
  TagBox[
   DynamicModuleBox[{Typeset`region = HoldComplete[
     Region[
      ImplicitRegion[
       And[
       2 <= $CellContext`c <= 12, 1 <= $CellContext`f <= 13, 
