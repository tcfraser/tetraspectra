       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"PauliMatrix", "[", "2", "]"}], ".", "H"}], "]"}], "/", 
       "2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
