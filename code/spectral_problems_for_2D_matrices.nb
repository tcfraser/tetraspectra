Cell["Numerical Explorations", "Section",
 CellChangeTimes->{{3.923453747027548*^9, 
  3.923453752368956*^9}},ExpressionUUID->"24a88419-eac3-c344-a9f2-\
8e4a74106c84"],

Cell[CellGroupData[{

Cell["Sampling", "Subsection",
 CellChangeTimes->{{3.9234673512248745`*^9, 
  3.9234673522292004`*^9}},ExpressionUUID->"2ed1a087-4fb1-f848-aa37-\
40d53094c99e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SeedRandom", "[", "906150257", "]"}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"from", " ", 
    RowBox[{"Poyla", "'"}], "s", " ", "conjecture", " ", "for", " ", 
    RowBox[{"fun", "!"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PoolSize", "=", "3000"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"SPHERICAL", " ", "MEASURES"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HaarUnitaryPool", "=", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"CircularUnitaryMatrixDistribution", "[", "2", "]"}], ",", 
      "PoolSize"}], "]"}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "A", " ", "large", " ", "pool", " ", "of", " ", "Haar", " ", "uniformly", 
    " ", "sampled", " ", "2", "x2", " ", "complex", " ", "unitary", " ", 
    RowBox[{"matrices", "."}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RandomUnitary", ":=", 
   RowBox[{"RandomChoice", "[", "HaarUnitaryPool", "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"S", " ", "MODIFIED", " ", "MEASURES"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HermitianAtCylindrical", "[", 
     RowBox[{"\[Rho]_", ",", "\[Phi]_", ",", "z_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"\[Rho]", "*", 
      RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
      RowBox[{"PauliMatrix", "[", "1", "]"}]}], "+", 
     RowBox[{"\[Rho]", "*", 
      RowBox[{"Sin", "[", "\[Phi]", "]"}], "*", 
      RowBox[{"PauliMatrix", "[", "2", "]"}]}], "+", 
     RowBox[{"z", "*", 
      RowBox[{"PauliMatrix", "[", "3", "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sDeformedPreFactor", "[", 
     RowBox[{"s_", ",", "\[Xi]_", ",", "z_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"s", "\[Equal]", "0"}], ",", "\[Xi]", ",", 
      FractionBox[
       RowBox[{"Sinh", "[", 
        RowBox[{"2", "s", "*", "\[Xi]"}], "]"}], 
       RowBox[{"2", "s", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cosh", "[", 
           RowBox[{"2", "s", "*", "\[Xi]"}], "]"}], "-", 
          RowBox[{"z", " ", 
           RowBox[{"Sinh", "[", 
            RowBox[{"2", "s", "*", "\[Xi]"}], "]"}]}]}], ")"}]}]]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sDeformedDist", "[", 
   RowBox[{"s_", ",", "\[Xi]_"}], "]"}], ":=", 
  RowBox[{"ProbabilityDistribution", "[", 
   RowBox[{
    RowBox[{"sDeformedPreFactor", "[", 
     RowBox[{"s", ",", "\[Xi]", ",", "z"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"+", "1"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "sDeformedRandomOrbitElementPool", "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"sDeformedRandomOrbitElementPool", "[", 
     RowBox[{"s_", ",", "\[Xi]_", ",", 
      RowBox[{"invert_", ":", 
       RowBox[{"+", "1"}]}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"sDeformedRandomOrbitElementPool", "[", 
      RowBox[{"s", ",", "\[Xi]", ",", "invert"}], "]"}], "=", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rand\[Phi]", ",", "randz"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rand\[Phi]", "=", 
         RowBox[{"RandomReal", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"2", "*", "Pi"}]}], "}"}], ",", "PoolSize"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Fix", " ", "for", " ", "Mathematicas", " ", "buggy", " ", 
          "sampling", " ", "for", " ", "cocentrated", " ", "measures", " ", 
          "on", " ", "boundary", " ", 
          RowBox[{"??", "??"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"randz", "=", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"sDeformedDist", "[", 
            RowBox[{"s", ",", "\[Xi]"}], "]"}], ",", "PoolSize", ",", 
           RowBox[{"Method", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"\"\<MCMC\>\"", ",", 
              RowBox[{"\"\<Thinning\>\"", "\[Rule]", "10"}], ",", 
              RowBox[{"\"\<InitialVariance\>\"", "\[Rule]", "1"}], ",", 
              RowBox[{"\"\<InitialPoint\>\"", "\[Rule]", "0.01"}], ",", 
              RowBox[{"\"\<BurnInPeriod\>\"", "\[Rule]", "1000"}]}], 
             "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"HermitianAtCylindrical", "[", 
            RowBox[{
             RowBox[{"\[Xi]", "*", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"1", "-", 
                SuperscriptBox[
                 RowBox[{
                 "randz", "\[LeftDoubleBracket]", "#", 
                  "\[RightDoubleBracket]"}], "2"]}], "]"}]}], ",", 
             RowBox[{
             "rand\[Phi]", "\[LeftDoubleBracket]", "#", 
              "\[RightDoubleBracket]"}], ",", 
             RowBox[{"invert", "*", "\[Xi]", "*", 
              RowBox[{
              "randz", "\[LeftDoubleBracket]", "#", 
               "\[RightDoubleBracket]"}]}]}], "]"}], "&"}], ",", 
          RowBox[{"Range", "[", "PoolSize", "]"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sDeformedRandomOrbitElementPool", "[", 
   RowBox[{"s_", ",", "\[Xi]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"sDeformedRandomOrbitElementPool", "[", 
    RowBox[{"s", ",", "\[Xi]"}], "]"}], "=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rand\[Phi]", ",", "randz"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rand\[Phi]", "=", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"2", "*", "Pi"}]}], "}"}], ",", "PoolSize"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"randz", "=", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "\[Xi]"}], ",", "\[Xi]"}], "}"}], ",", "PoolSize"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"s", "*", 
               RowBox[{
               "randz", "\[LeftDoubleBracket]", "#", 
                "\[RightDoubleBracket]"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{"\[ImaginaryI]", "*", 
                RowBox[{
                "rand\[Phi]", "\[LeftDoubleBracket]", "#", 
                 "\[RightDoubleBracket]"}]}], "]"}], "*", 
              RowBox[{"Sqrt", "[", 
               RowBox[{
                RowBox[{"Exp", "[", 
                 RowBox[{"2", "*", "s", "*", "\[Xi]"}], "]"}], "+", 
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{"-", "2"}], "*", "s", "*", "\[Xi]"}], "]"}], "-", 
                RowBox[{"Exp", "[", 
                 RowBox[{"2", "*", "s", "*", 
                  RowBox[{
                  "randz", "\[LeftDoubleBracket]", "#", 
                   "\[RightDoubleBracket]"}]}], "]"}], "-", 
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{"-", "2"}], "*", "s", "*", 
                  RowBox[{
                  "randz", "\[LeftDoubleBracket]", "#", 
                   "\[RightDoubleBracket]"}]}], "]"}]}], "]"}]}]}], "}"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "s"}], "*", 
               RowBox[{
               "randz", "\[LeftDoubleBracket]", "#", 
                "\[RightDoubleBracket]"}]}], "]"}]}], "}"}]}], "}"}], "&"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"Range", "[", "PoolSize", "]"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}]}], "Input",
 InitializationCell->True,
