Cell[CellGroupData[{

Cell["Dealing with imprecision in imaginary parts ", "Subsection",
 CellChangeTimes->{{3.9234676678001556`*^9, 3.923467721981262*^9}, {
  3.923467764333637*^9, 
  3.923467784181999*^9}},ExpressionUUID->"ea5de0f3-cf66-d84c-a824-\
a653674cf538"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"HermitianPart", "[", "matrix_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"matrix", "+", 
      RowBox[{"ConjugateTranspose", "[", "matrix", "]"}]}], ")"}], "/", 
    "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RealEigenvalues", "[", "herm_", "]"}], ":=", 
   RowBox[{"Map", "[", 
    RowBox[{"Re", ",", 
     RowBox[{"Eigenvalues", "[", "herm", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RealSingularvalues", "[", "matrix_", "]"}], ":=", 
   RowBox[{"Map", "[", 
    RowBox[{"Re", ",", 
     RowBox[{"SingularValueList", "[", "matrix", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LeadingSingularvalue", "[", "matrix_", "]"}], ":=", 
   RowBox[{"Max", "[", 
    RowBox[{"Map", "[", 
     RowBox[{"Re", ",", 
      RowBox[{"SingularValueList", "[", "matrix", "]"}]}], "]"}], "]"}]}], 
  ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.923456075931639*^9, 3.923456109423222*^9}, {
  3.923458754694094*^9, 3.923458776078575*^9}, {3.923459150285776*^9, 
  3.9234591876708508`*^9}, {3.923473176323604*^9, 3.9234732036897945`*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"07ac20bd-d586-4440-9512-054e9ee836e5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Anti-Transpose", "Subsection",
 CellChangeTimes->{{3.924060639984106*^9, 
  3.9240606428634176`*^9}},ExpressionUUID->"4fb06efd-0cb3-2a45-8217-\
e585ce66f903"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AntiTranspose", "[", "M_", "]"}], ":=", 
  RowBox[{"Transpose", "[", 
   RowBox[{"Reverse", "[", 
    RowBox[{"Transpose", "[", 
     RowBox[{"Reverse", "[", "M", "]"}], "]"}], "]"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.924060650410902*^9, 3.9240606693568783`*^9}},
 CellLabel->"In[95]:=",ExpressionUUID->"7afa847c-d2c7-b24e-8da6-005abdefd84f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"MatrixForm", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"c", ",", "d"}], "}"}]}], "}"}], "]"}], ",", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"AntiTranspose", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", "d"}], "}"}]}], "}"}], "]"}], "]"}]}], 
  "}"}]], "Input",
 CellChangeTimes->{{3.924060677475071*^9, 3.924060712882431*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"83227f54-91e7-4e47-bc52-54ab10e71987"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"a", "b"},
       {"c", "d"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]], ",", 
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"d", "c"},
       {"b", "a"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]]}], "}"}]], "Output",
 CellChangeTimes->{3.924060713313799*^9},
 CellLabel->"Out[15]=",ExpressionUUID->"0782256c-3f6b-2a4f-889a-db41ac27a3e5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Orbit Parametrizations", "Subsection",
 CellChangeTimes->{{3.923467934738844*^9, 
  3.9234679422661285`*^9}},ExpressionUUID->"056ceede-b306-b144-abe3-\
53295893e038"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CoadjointOrbit", "[", 
     RowBox[{"\[Lambda]_", ",", "U_"}], "]"}], ":=", 
    RowBox[{"HermitianPart", "[", 
     RowBox[{"U", ".", 
      RowBox[{"DiagonalMatrix", "[", "\[Lambda]", "]"}], ".", 
