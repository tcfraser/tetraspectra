Cell[BoxData[
 RowBox[{
  RowBox[{"DensityPlot3DWithTetrahedraDensity", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "xmin", ",", "xmax", ",", "ymin", ",", "ymax", ",", "t1", ",", "t2", ",",
       "t3"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"xmin", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{"b", "-", "a"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"xmax", "=", 
      RowBox[{"a", "+", "b"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ymin", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{"c", "-", "b"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ymax", "=", 
      RowBox[{"b", "+", "c"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"DensityPlot3D", "[", 
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Prob", "[", 
           RowBox[{"a", ",", "b", ",", "c"}], "]"}], "[", 
          RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", "5"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "ymin", ",", "ymax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "0", ",", 
         RowBox[{"a", "+", "b", "+", "c"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", "Automatic"}], ",", 
       RowBox[{"PlotPoints", "->", "50"}]}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.925296013478843*^9, 3.9252960303209705`*^9}, {
   3.925296094572626*^9, 3.925296217970835*^9}, {3.9252973743994675`*^9, 
