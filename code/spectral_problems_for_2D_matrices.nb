Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Histogram", "[", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"sDeformedDist", "[", 
       RowBox[{"1", ",", "1"}], "]"}], ",", "PoolSize"}], "]"}], "]"}], ",", 
   RowBox[{"Histogram", "[", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"sDeformedDist", "[", 
       RowBox[{"1", ",", "1"}], "]"}], ",", "PoolSize", ",", 
      RowBox[{"Method", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<MCMC\>\"", ",", 
         RowBox[{"\"\<Thinning\>\"", "\[Rule]", "1"}], ",", 
         RowBox[{"\"\<InitialVariance\>\"", "\[Rule]", "1"}], ",", 
         RowBox[{"\"\<InitialPoint\>\"", "\[Rule]", "0.01"}], ",", 
         RowBox[{"\"\<BurnInPeriod\>\"", "\[Rule]", "100"}]}], "}"}]}]}], 
     "]"}], "]"}]}], "}"}]], "Input",
