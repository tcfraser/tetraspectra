Cell[BoxData[
 RowBox[{"admissibleTriangleRegion", "=", 
  RowBox[{"Region", "[", 
   RowBox[{"ImplicitRegion", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"b", "-", "a"}], "]"}], "\[LessEqual]", "c", "\[LessEqual]", 
         RowBox[{"a", "+", "b"}]}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"b", "-", "d"}], "]"}], "\[LessEqual]", "f", "\[LessEqual]", 
         RowBox[{"b", "+", "d"}]}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"d", "-", "c"}], "]"}], "\[LessEqual]", "e", "\[LessEqual]", 
         RowBox[{"d", "+", "c"}]}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"f", "-", "a"}], "]"}], "\[LessEqual]", "e", "\[LessEqual]", 
         RowBox[{"a", "+", "f"}]}], ")"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "->", "5"}], ",", 
        RowBox[{"b", "->", "7"}], ",", 
        RowBox[{"d", "->", "6"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"c", ",", "e", ",", "f"}], "}"}]}], "]"}], "]"}]}]], "Input",Exp\
ressionUUID->"b1357b4c-670e-0148-bbee-3fca5f4330c5"],

