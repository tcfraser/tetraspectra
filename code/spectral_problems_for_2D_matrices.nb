Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Unrealizability", " ", "witnessed", " ", "by", " ", "SSA", " ", "but", 
    " ", "not", " ", "face", " ", "triangle", " ", "inequalities"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RegionPlot3D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SSANonUniformIneqLargeMu", "[", 
          RowBox[{
          "example\[Alpha]", ",", "example\[Beta]", ",", "example\[Gamma]", 
           ",", "x", ",", "y", ",", "z"}], "]"}], "<", "0"}], ")"}], "&&", 
       RowBox[{"triangleIneqs", "[", 
        RowBox[{
        "example\[Alpha]", ",", "example\[Beta]", ",", "example\[Gamma]"}], 
        "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"Abs", "[", 
         RowBox[{"example\[Alpha]", "-", "example\[Beta]"}], "]"}], ",", 
        RowBox[{"example\[Alpha]", "+", "example\[Beta]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{"Abs", "[", 
         RowBox[{"example\[Gamma]", "-", "example\[Beta]"}], "]"}], ",", 
        RowBox[{"example\[Gamma]", "+", "example\[Beta]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "0", ",", 
        RowBox[{
        "example\[Alpha]", "+", "example\[Beta]", "+", "example\[Gamma]"}]}], 
       "}"}]}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"TracelessSpectraToAdmissibleRegion", "[", 
     RowBox[{
     "example\[Alpha]", ",", "example\[Beta]", ",", "example\[Gamma]"}], 
     "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
