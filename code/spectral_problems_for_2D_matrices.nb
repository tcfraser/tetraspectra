Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"ALL", " ", "Triangle", " ", "inequalities"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"triangleIneqs", "[", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"y", "-", "a"}], "]"}], "\[LessEqual]", "z", "\[LessEqual]", 
       RowBox[{"y", "+", "a"}]}], ")"}], "&&", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"x", "-", "c"}], "]"}], "\[LessEqual]", "z", "\[LessEqual]", 
       RowBox[{"x", "+", "c"}]}], ")"}], "&&", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"b", "-", "a"}], "]"}], "\[LessEqual]", "x", "\[LessEqual]", 
       RowBox[{"b", "+", "a"}]}], ")"}], "&&", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"z", "-", "c"}], "]"}], "\[LessEqual]", "x", "\[LessEqual]", 
       RowBox[{"z", "+", "c"}]}], ")"}], "&&", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"b", "-", "c"}], "]"}], "\[LessEqual]", "y", "\[LessEqual]", 
       RowBox[{"b", "+", "c"}]}], ")"}], "&&", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"z", "-", "a"}], "]"}], "\[LessEqual]", "y", "\[LessEqual]", 
       RowBox[{"z", "+", "a"}]}], ")"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"RegionPlot3D", "[", 
      RowBox[{
       RowBox[{"Not", "[", 
        RowBox[{"triangleIneqs", "[", 
         RowBox[{
         "example\[Alpha]", ",", "example\[Beta]", ",", "example\[Gamma]"}], 
         "]"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"Abs", "[", 
          RowBox[{"example\[Alpha]", "-", "example\[Beta]"}], "]"}], ",", 
         RowBox[{"example\[Alpha]", "+", "example\[Beta]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"Abs", "[", 
          RowBox[{"example\[Gamma]", "-", "example\[Beta]"}], "]"}], ",", 
         RowBox[{"example\[Gamma]", "+", "example\[Beta]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "0", ",", 
         RowBox[{
         "example\[Alpha]", "+", "example\[Beta]", "+", "example\[Gamma]"}]}],
         "}"}], "\[IndentingNewLine]", ",", 
       RowBox[{"PlotPoints", "\[Rule]", "30"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"TracelessSpectraToAdmissibleRegion", "[", 
      RowBox[{
      "example\[Alpha]", ",", "example\[Beta]", ",", "example\[Gamma]"}], 
      "]"}]}], "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9260012471508417`*^9, 3.926001312507797*^9}, {
  3.92600135138936*^9, 3.9260014448647447`*^9}, {3.9260014965213976`*^9, 
  3.926001518721734*^9}, {3.926001960173777*^9, 3.926002103833811*^9}, {
  3.926002135737678*^9, 3.926002196606655*^9}, {3.9260022813090277`*^9, 
  3.9260022923700914`*^9}},
 CellLabel->
  "In[130]:=",ExpressionUUID->"c2c22686-399f-4402-ab21-f5bd9b50dd41"],

