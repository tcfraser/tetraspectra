Cell["Analytics", "Section",
 CellChangeTimes->{{3.925302577123184*^9, 
  3.925302585782475*^9}},ExpressionUUID->"0d3f2a8d-2e31-904a-bafa-\
e95c241e1f44"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"t1", "=", 
   RowBox[{
    SuperscriptBox["x", "2"], "+", 
    SuperscriptBox["y", "2"], "-", 
    SuperscriptBox["b", "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t2", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"4", " ", 
         SuperscriptBox["a", "2"], 
         SuperscriptBox["b", "2"]}], "-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["a", "2"], "+", 
           SuperscriptBox["b", "2"], "-", 
           SuperscriptBox["x", "2"]}], ")"}], "2"]}], "]"}]}], 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"4", " ", 
        SuperscriptBox["b", "2"], 
        SuperscriptBox["c", "2"]}], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["b", "2"], "+", 
