Cell[BoxData[
 RowBox[{
  RowBox[{"TracelessSpectraToAdmissibleRegion", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "xmin", ",", "xmax", ",", "ymin", ",", "ymax", ",", "t1", ",", "t2", ",",
       "t3"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"xmin", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{"b", "-", "a"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"xmax", "=", 
      RowBox[{"a", "+", "b"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ymin", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{"c", "-", "b"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ymax", "=", 
      RowBox[{"b", "+", "c"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"t1", "=", 
      RowBox[{
       SuperscriptBox["x", "2"], "+", 
       SuperscriptBox["y", "2"], "-", 
       SuperscriptBox["b", "2"]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"t2", "=", 
      FractionBox[
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"4", " ", 
            SuperscriptBox["a", "2"], 
            SuperscriptBox["b", "2"]}], "-", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["a", "2"], "+", 
              SuperscriptBox["b", "2"], "-", 
              SuperscriptBox["x", "2"]}], ")"}], "2"]}], "]"}]}], 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"4", " ", 
           SuperscriptBox["b", "2"], 
           SuperscriptBox["c", "2"]}], "-", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["b", "2"], "+", 
             SuperscriptBox["c", "2"], "-", 
             SuperscriptBox["y", "2"]}], ")"}], "2"]}], "]"}]}], 
       RowBox[{"2", 
        SuperscriptBox["b", "2"]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"t3", "=", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["a", "2"], "+", 
          SuperscriptBox["b", "2"], "-", 
          SuperscriptBox["x", "2"]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["b", "2"], "+", 
          SuperscriptBox["c", "2"], "-", 
          SuperscriptBox["y", "2"]}], ")"}]}], 
       RowBox[{"2", 
        SuperscriptBox["b", "2"]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Show", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Plot3D", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"t1", "+", "t2", "+", "t3"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "ymin", ",", "ymax"}], "}"}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", "boundaryColor"}], ",", 
         RowBox[{"MeshStyle", "\[Rule]", 
          RowBox[{"Opacity", "[", "0.1", "]"}]}], ",", 
         RowBox[{"Axes", "->", "False"}], ",", 
         RowBox[{"Boxed", "->", "False"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Plot3D", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"t1", "-", "t2", "+", "t3"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "ymin", ",", "ymax"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", "boundaryColor"}], ",", 
         RowBox[{"MeshStyle", "\[Rule]", 
          RowBox[{"Opacity", "[", "0.1", "]"}]}], ",", 
         RowBox[{"Axes", "->", "False"}], ",", 
         RowBox[{"Boxed", "->", "False"}]}], "]"}]}], "\[IndentingNewLine]", 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.925292169204685*^9, 3.925292476036611*^9}, {
