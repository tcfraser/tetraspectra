Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"admissibleRegion", "=", 
  RowBox[{"Region", "[", 
   RowBox[{"ImplicitRegion", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"b", "-", "a"}], "]"}], "\[LessEqual]", "c", "\[LessEqual]", 
         RowBox[{"a", "+", "b"}]}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"b", "-", "d"}], "]"}], "\[LessEqual]", "f", "\[LessEqual]", 
         RowBox[{"b", "+", "d"}]}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"d", "-", "c"}], "]"}], "\[LessEqual]", "e", "\[LessEqual]", 
         RowBox[{"d", "+", "c"}]}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Abs", "[", 
