       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"PauliMatrix", "[", "3", "]"}], ".", "H"}], "]"}], "/", 
       "2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
