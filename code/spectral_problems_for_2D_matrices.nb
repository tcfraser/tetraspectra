                RowBox[{
                 SuperscriptBox["a", "2"], "+", 
                 SuperscriptBox["b", "2"], "-", 
                 SuperscriptBox["x", "2"]}], ")"}], "2"]}], "]"}]}], 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"4", " ", 
              SuperscriptBox["b", "2"], 
              SuperscriptBox["c", "2"]}], "-", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["b", "2"], "+", 
                SuperscriptBox["c", "2"], "-", 
                SuperscriptBox["y", "2"]}], ")"}], "2"]}], "]"}]}], 
          RowBox[{"2", 
           SuperscriptBox["b", "2"]}]]}], ";", "\[IndentingNewLine]", 
        RowBox[{"t3", "=", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["a", "2"], "+", 
             SuperscriptBox["b", "2"], "-", 
             SuperscriptBox["x", "2"]}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["b", "2"], "+", 
             SuperscriptBox["c", "2"], "-", 
             SuperscriptBox["y", "2"]}], ")"}]}], 
          RowBox[{"2", 
           SuperscriptBox["b", "2"]}]]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"xmin", "<=", "x", "<=", "xmax"}], ")"}], "&&", 
           RowBox[{"(", 
            RowBox[{"ymin", "<=", "y", "<=", "ymax"}], ")"}], "&&", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Im", "[", "t2", "]"}], "<=", 
            SuperscriptBox["10", 
             RowBox[{"-", "4"}]]}], "&&", 
           RowBox[{
            RowBox[{"Im", "[", 
             RowBox[{"t1", "-", "t2", "+", "t3"}], "]"}], "<=", 
            SuperscriptBox["10", 
             RowBox[{"-", "4"}]]}], "&&", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"t1", "-", "t2", "+", "t3"}], "]"}], ">=", "0"}], "&&", 
           "\[IndentingNewLine]", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{"Re", "[", 
               RowBox[{"t1", "+", "t2", "+", "t3"}], "]"}], "]"}], "<=", "z", 
             "<=", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"Re", "[", 
               RowBox[{"t1", "-", "t2", "+", "t3"}], "]"}], "]"}]}], ")"}]}], 
          ",", "\[IndentingNewLine]", 
          FractionBox[
           RowBox[{"x", "*", "y", "*", "z"}], 
           RowBox[{"2", "*", "Pi", "*", "a", "*", "b", "*", "c", "*", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"Q", "[", 
              RowBox[{"a", ",", "b", ",", "c", ",", "x", ",", "y", ",", "z"}],
