Cell[BoxData[
 RowBox[{"admissibleRegion", "=", 
  RowBox[{"Region", "[", 
   RowBox[{"ImplicitRegion", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"b", "-", "a"}], "]"}], "\[LessEqual]", "c", "\[LessEqual]", 
         RowBox[{"a", "+", "b"}]}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"b", "-", "d"}], "]"}], "\[LessEqual]", "f", "\[LessEqual]", 
         RowBox[{"b", "+", "d"}]}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"d", "-", "c"}], "]"}], "\[LessEqual]", "e", "\[LessEqual]", 
         RowBox[{"d", "+", "c"}]}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"f", "-", "a"}], "]"}], "\[LessEqual]", "e", "\[LessEqual]", 
         RowBox[{"a", "+", "f"}]}], ")"}], "&&", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Det", "[", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0", ",", 
             SuperscriptBox["a", "2"], ",", 
             SuperscriptBox["e", "2"], ",", 
             SuperscriptBox["c", "2"]}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             SuperscriptBox["a", "2"], ",", "0", ",", 
             SuperscriptBox["f", "2"], ",", 
             SuperscriptBox["b", "2"]}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             SuperscriptBox["e", "2"], ",", 
             SuperscriptBox["f", "2"], ",", "0", ",", 
             SuperscriptBox["d", "2"]}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             SuperscriptBox["c", "2"], ",", 
             SuperscriptBox["b", "2"], ",", 
             SuperscriptBox["d", "2"], ",", "0"}], "}"}]}], "}"}], "]"}], ">=",
         "0"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "->", "5"}], ",", 
        RowBox[{"b", "->", "7"}], ",", 
        RowBox[{"d", "->", "6"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
