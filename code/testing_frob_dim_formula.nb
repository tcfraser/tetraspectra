7a053eabd3e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Frob", "[", 
    RowBox[{"\[Lambda]_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"Factorial", "[", 
      RowBox[{"Total", "[", "\[Lambda]", "]"}], "]"}], 
     RowBox[{"Apply", "[", 
      RowBox[{"Times", ",", 
       RowBox[{"Map", "[", 
        RowBox[{"Factorial", ",", 
         RowBox[{"Shifted", "[", 
          RowBox[{"\[Lambda]", ",", "n"}], "]"}]}], "]"}]}], "]"}]], "*", 
    RowBox[{"VandermondeDet", "[", 
     RowBox[{"Shifted", "[", 
      RowBox[{"\[Lambda]", ",", "n"}], "]"}], "]"}]}]}], 
  "\[IndentingNewLine]"}]], "Input",
