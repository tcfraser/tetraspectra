Cell[BoxData[{
 RowBox[{
  RowBox[{"Shifted", "[", 
   RowBox[{"\[Lambda]_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "padded", "}"}], ",", 
    RowBox[{
     RowBox[{"padded", "=", 
      RowBox[{"PadRight", "[", 
       RowBox[{"\[Lambda]", ",", "n"}], "]"}]}], ";", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
         "padded", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
         "+", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"n", "-", "#"}], ",", "0"}], "]"}]}], "&"}], ",", 
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "padded", "]"}], "]"}]}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VandermondeDet", "[", "x_", "]"}], ":=", 
  RowBox[{"Apply", "[", 
   RowBox[{"Times", ",", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "<", "j"}], ",", 
         RowBox[{
          RowBox[{"x", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
           "-", 
          RowBox[{
          "x", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], ",", 
         "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "x", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"Length", "[", "x", "]"}]}], "}"}]}], "]"}], "]"}]}], 
   "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9482054705498505`*^9, 3.9482055955767097`*^9}, {
  3.9482056525237637`*^9, 3.948205664319515*^9}, {3.948258896358116*^9, 
