Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"targets", " ", "PSD", " ", "eigenvalues", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "a"}], ",", "0"}], ")"}]}], ",", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "b"}], ",", "0"}], ")"}], ",", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"a", "+", "b", "+", "c"}], ",", 
      RowBox[{"a", "+", "b", "-", "c"}]}], ")"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SatisfiedAtLevelK", "[", "k_", "]"}], ":=", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a", "+", "b", "-", "c"}], "\[GreaterEqual]", "0"}], ")"}], 
       RowBox[{"(*", " ", 
        RowBox[{
        "inequalities", " ", "implicitly", " ", "work", " ", "with", " ", 
         "PSD", " ", "eigenvalues"}], " ", "*)"}], "\[IndentingNewLine]", "&&", 
       RowBox[{"Apply", "[", 
        RowBox[{"And", ",", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"IsInequalityNumericallySatisfied", "[", 
              RowBox[{"#", ",", 
               RowBox[{"k", "-", "#"}]}], "]"}], "[", 
             RowBox[{"a", ",", "b", ",", "c"}], "]"}], "&"}], ",", 
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", "k", ",", "1"}], "]"}]}], "]"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
