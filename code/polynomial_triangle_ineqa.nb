Notebook[{
Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{"test", " ", "eigenvalues", " ", "are", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"+", "a"}], ",", 
      RowBox[{"-", "a"}]}], ")"}]}], ",", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"+", "b"}], ",", 
     RowBox[{"-", "b"}]}], ")"}], ",", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"+", "c"}], ",", 
     RowBox[{"-", "c"}]}], ")"}], ",", " ", 
   RowBox[{"shifted", " ", "to", " ", "positive", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"+", "2"}], "a"}], ",", "0"}], ")"}]}], ",", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"+", "2"}], "b"}], ",", "0"}], ")"}], ",", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"a", "+", "b", "-", "c"}], ",", 
     RowBox[{"a", "+", "b", "-", "c"}]}], ")"}]}], " ", "*)"}]], "Input",Expre\
ssionUUID->"a0dbdb9e-0c15-46e8-b65c-4198aed7f62a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TriangleIneqs", "=", 
  RowBox[{"RegionPlot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"b", "-", "1"}], "]"}], "<=", "c", "<=", 
     RowBox[{"1", "+", "b"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"b", ",", "0", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"c", ",", "0", ",", "2"}], "}"}], ",", 
    RowBox[{
    "PlotLabel", "\[Rule]", 
     "\"\<Triangle inequalities \\n eigenvalues (a,-a),(b,-b),(c,-c) \\n \
admissible (a,b,c) for a=1 and (b,c)\[Element][0,2]\[Cross][0,2]\>\""}]}], 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9595983770815744`*^9, 3.959598451532829*^9}, {
