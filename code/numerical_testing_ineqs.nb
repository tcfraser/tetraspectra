          RowBox[{
          "sextuple", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
          "]"}]}], "]"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
