 RowBox[{
  RowBox[{"SraESPIneq", "[", 
   RowBox[{"k_", ",", "sextuple_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "f", "}"}], ",", 
