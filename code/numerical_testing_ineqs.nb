          "sextuple", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
          "]"}]}], "]"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "[", "3", "]"}], "*", 
       RowBox[{"f", "[", "6", "]"}]}], "-", 
      RowBox[{
       RowBox[{"f", "[", "2", "]"}], "*", 
       RowBox[{"f", "[", "5", "]"}]}]}]}]}], "\[IndentingNewLine]", 
