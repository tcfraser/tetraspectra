       RowBox[{"1", "/", "k"}]], "-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"f", "[", "1", "]"}], "*", 
         RowBox[{"f", "[", "4", "]"}]}], ")"}], 
       RowBox[{"1", "/", "k"}]]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
